    {"name": "pytest_timing", "cmd": "python -m pytest -p no:cacheprovider -rsx -s -v tests/gpu/test_timing.py",
     "timeout": 900, "stop_on_fail": false},
    {"name": "pytest_engine_regression", "cmd": "python -m pytest -p no:cacheprovider -rs -q -m \"not slow\" tests/gpu/test_engine.py tests/gpu/test_bitonic.py",
     "timeout": 1800, "stop_on_fail": false},
    {"name": "kernel_sweep", "cmd": "python bench/run_kernels.py --part gpu --seed 7 {quick} --out runs",
     "timeout": 3600, "stop_on_fail": false},
    {"name": "cpu_baselines", "cmd": "python bench/run_kernels.py --part cpu --seed 7 {quick} --out runs",
     "timeout": 7200, "stop_on_fail": false},
    {"name": "crossover", "cmd": "python bench/run_kernels.py --part crossover --seed 7 {quick} --out runs",
     "timeout": 300, "stop_on_fail": false},
    {"name": "pipeline", "cmd": "python bench/run_pipeline.py --dev --full --seed 7 {quick} --out runs",
     "timeout": 3600, "stop_on_fail": false},
    {"name": "nvidia_smi_after", "cmd": "nvidia-smi", "timeout": 120, "stop_on_fail": false}
  ]
}
